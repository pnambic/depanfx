<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>


<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pnambic.depanfx.nodelist.viewer.DepanFxNodeListViewerDialog"
            prefWidth="400" >
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

        <Label text="Viewer Title" />

        <TextField fx:id="viewerTitleField"/>

         <HBox spacing="10">
            <Label text="Node List"/>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="saveNodeListLabel" text="Save New Node List..."
                onMouseClicked="#handleNewNodeList" />
         </HBox>

         <HBox spacing="10">
            <TextField fx:id="nodeListRsrcField"
                  editable="false" promptText="No file selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#openNodeListChooser"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Table View"/>

         <HBox spacing="10">
            <TextField fx:id="tableViewRsrcField"
                  editable="false" promptText="No table view selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#openTableViewChooser"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Region VBox.vgrow="ALWAYS" />

         <HBox spacing="10">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Open" onAction="#handleOpen"/>
         </HBox>

   </VBox>

</AnchorPane>
