<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="500" prefHeight="600"
            fx:controller="com.pnambic.depanfx.perspective.chooser.DepanFxResourceChooserDialog">

    <top>
        <Label text="Resource Chooser:" alignment="CENTER"/>
    </top>

    <left>
        <TreeView fx:id="directoryTreeView">
        </TreeView>
    </left>

    <center>
        <ListView fx:id="fileListView"/>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="40"/>
            </padding>
            <HBox spacing="10">
                <Label text="Resource:" alignment="CENTER_RIGHT"/>
                <TextField fx:id="resourceNameField"
                      promptText="Resource to load"
                      HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="fileTypeComboBox" promptText="Resource Type"/>
            </HBox>
            <VBox >
                <HBox spacing="10" alignment="CENTER_RIGHT">
                   <Button text="Open" fx:id="openButton"
                       onAction="#handleOpen"/>
                   <Button text="Cancel" fx:id="cancelButton"
                       onAction="#handleCancel"/>
                </HBox>
            </VBox>
        </VBox>
    </bottom>
</BorderPane>
