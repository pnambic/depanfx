<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="400"
            fx:controller="com.pnambic.depanfx.session.gui.DepanFxSessionSaveDialog" >

   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <Label text="Session Details"/>

         <Label fx:id="sessionDetailsLabel"/>

         <Label text="Select Destination File"/>

         <HBox spacing="10">
            <TextField fx:id="destinationField"
                  editable="true" promptText="No file selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#openFileChooser"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Region VBox.vgrow="ALWAYS" />

         <HBox spacing="10">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Confirm" onAction="#handleConfirm"/>
         </HBox>

   </VBox>

</AnchorPane>
