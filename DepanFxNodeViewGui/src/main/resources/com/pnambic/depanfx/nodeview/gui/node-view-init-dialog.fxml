<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pnambic.depanfx.nodeview.gui.DepanFxNodeViewInitDialog"
            prefWidth="400" >
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <Label text="Node Layout"/>

         <HBox spacing="10">
            <TextField fx:id="nodeLayoutRsrcField"
                  editable="false" promptText="No layout selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#openNodeLayoutChooser"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Region VBox.vgrow="ALWAYS" />

         <HBox spacing="10">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Open" onAction="#handleOpen"/>
         </HBox>

   </VBox>

</AnchorPane>
