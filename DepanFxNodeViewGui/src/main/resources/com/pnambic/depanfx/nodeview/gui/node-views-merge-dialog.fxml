<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="500"
            fx:controller="com.pnambic.depanfx.nodeview.gui.DepanFxNodeViewsMergeDialog">
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <Label text="Node Views to Merge"/>

         <TableView fx:id="nodeViewsTable" editable="true"
            VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="View Name"
                    editable="true"
                    prefWidth="160" minWidth="80">
                </TableColumn>
                <TableColumn text="View Description"
                    editable="true"
                    prefWidth="160" minWidth="80">
                </TableColumn>
                <TableColumn text="Edit"
                    prefWidth="40"
                    editable="false" resizable="false" sortable="false">
                </TableColumn>
            </columns>
         </TableView>

         <HBox>
            <Button text="Add Node View" onAction="#handleAddNodeView" />
         </HBox>

         <Label text="Select Destination File"/>

         <HBox spacing="10">
            <TextField fx:id="destinationField" editable="false" promptText="No file selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#openDestinationChooser" />
         </HBox>

         <HBox spacing="10">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Merge" onAction="#handleMerge"/>
         </HBox>

   </VBox>

</AnchorPane>
