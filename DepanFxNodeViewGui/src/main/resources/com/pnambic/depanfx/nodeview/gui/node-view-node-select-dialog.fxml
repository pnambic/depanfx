<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="400"
            fx:controller="com.pnambic.depanfx.nodeview.gui.DepanFxNodeViewNodeSelectDialog" >
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <Label text="Nodes"/>

         <TreeTableView fx:id="nodeSelectTable"
            editable="true"
            showRoot="false"
            VBox.vgrow="ALWAYS">
            <columns>
                <TreeTableColumn text="Node Name"
                    prefWidth="300">
                </TreeTableColumn>
            </columns>
         </TreeTableView>

         <Label text="Saved Node List Name"/>

         <HBox spacing="10">
            <TextField fx:id="toolNameField" editable="true"
                  promptText="Display label selected nodes."
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Saved Node List Description"/>

         <HBox spacing="10">
            <TextField fx:id="toolDescriptionField" editable="true"
                  promptText="Description for selected nodes."
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Select Destination File"/>

         <HBox spacing="10">
            <TextField fx:id="destinationField" editable="false"
                  promptText="No file selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#openDestinationChooser"/>
         </HBox>

         <HBox spacing="10">
            <Button text="Cancel" onAction="#handleRevert"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Apply" onAction="#handleApply"/>
            <Button text="Confirm" onAction="#handleConfirm"/>
         </HBox>

   </VBox>

</AnchorPane>
