<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="400"
            fx:controller="com.pnambic.depanfx.nodeview.gui.DepanFxNodeViewNodeSelectDialog" >
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <HBox spacing="10">
            <Label text="Nodes"/>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="nodeTableCommands" text="Commands..."/>
         </HBox>

         <!-- Placement by FXML, behaviors by DepanFXNodeListTableState etal. -->
         <TreeTableView fx:id="nodeSelectTable" VBox.vgrow="ALWAYS"/>

         <HBox spacing="10">
            <Button text="Close" onAction="#handleCancel"/>
         </HBox>

   </VBox>

</AnchorPane>
