<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="440"
            fx:controller="com.pnambic.depanfx.nodeview.gui.DepanFxNodeViewEdgeVisibilityDialog">
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <Label text="Visibility Matchers...">
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuItem text="Select All"
                            onAction="#handleSelectAll"/>
                        <MenuItem text="Clear Selection"
                            onAction="#handleClearSelection"/>
                        <MenuItem text="Invert Selection"
                            onAction="#handleInvertSelection"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Select Visible Edges..."
                            onAction="#handleSelectVisibleEdges"/>
                        <MenuItem text="Save Visible Edges..."
                            onAction="#handleSaveVisibleEdges"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Select Available Edges..."
                            onAction="#handleSelectAvailableVisibleEdges"/>
                        <MenuItem text="Save Available Edges..."
                            onAction="#handleSaveAvailableEdges"/>
                    </items>
                </ContextMenu>
            </contextMenu>
         </Label>

         <TableView fx:id="matcherVisibilityTable" editable="true"
            VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Link Matcher Name"
                    prefWidth="160" minWidth="50"
                    editable="false" sortable="false">
                </TableColumn>
                <TableColumn text = "Visible"
                    prefWidth="80"
                    editable="true" resizable="false" sortable="false">
                </TableColumn>
                <TableColumn text = "Edge Count"
                    prefWidth="80"
                    editable="true" resizable="false" sortable="false">
                </TableColumn>
            </columns>
         </TableView>

         <Label text="Tool Name"/>

         <HBox spacing="10">
            <TextField fx:id="toolNameField" editable="true"
                  promptText="Visbile Edge List Name"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Tool Description"/>

         <HBox spacing="10">
            <TextField fx:id="toolDescriptionField" editable="true"
                  promptText="Description for visible edge lists."
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Select Destination File"/>

         <HBox spacing="10">
            <TextField fx:id="destinationField" editable="false" promptText="No file selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse..." onAction="#openDestinationChooser" />
         </HBox>

         <HBox spacing="10">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Apply" onAction="#handleApply"/>
            <Button text="Confirm" onAction="#handleConfirm"/>
         </HBox>

   </VBox>

</AnchorPane>
