<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.TreeItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="600"
            fx:controller="com.pnambic.depanfx.nodefilters.gui.DepanFxNodeViewNodeFiltersDialog" >
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

      <SplitPane fx:id="splitPane"
                 dividerPositions="0.5" orientation="VERTICAL"
                 HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
         <items>
            <!-- View of Filters -->
            <AnchorPane HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <VBox spacing="10" layoutX="10" layoutY="10"
                     AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
                     AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

                  <HBox spacing="10">
                     <Label text="Filters..." fx:id="filtersCommands"/>
                     <Region HBox.hgrow="ALWAYS" />
                  </HBox>

                  <TreeTableView fx:id="nodeFilterTable"
                        editable="true" showRoot="false"
                        HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                        minHeight="20">
                     <columns>
                         <TreeTableColumn  text="Label"
                             editable="true"
                             prefWidth="150.0"/>
                         <TreeTableColumn text="Closure"
                             editable="true"
                             prefWidth="70.0"/>
                         <TreeTableColumn text="Merge"
                             editable="true"
                             prefWidth="70.0"/>
                         <TreeTableColumn text="Description"
                             editable="true"
                             prefWidth="150.0"/>
                     </columns>
                  </TreeTableView>

                  <HBox spacing="10">
                     <Region HBox.hgrow="ALWAYS" />
                     <Button text="Save Filters..." onAction="#handleSaveFilters"/>
                  </HBox>

               </VBox>
            </AnchorPane>

            <!-- View of Nodes -->
            <AnchorPane HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <VBox spacing="10" layoutX="10" layoutY="10"
                     AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
                     AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

                  <HBox spacing="10">
                     <HBox spacing="10" HBox.hgrow="ALWAYS" >
                         <Label text="Nodes..." fx:id="nodeTableCommands"/>
                     </HBox>
                     <Button text="Update" onAction="#handleEvaluate"/>
                     <Region HBox.hgrow="ALWAYS" />
                  </HBox>

                  <TreeTableView fx:id="nodeSelectTable"
                        HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                        minHeight="20"/>
               </VBox>
            </AnchorPane>
         </items>
      </SplitPane>

      <HBox spacing="10">
         <Button text="Close" onAction="#handleCancel"/>
         <Region HBox.hgrow="ALWAYS" />
         <Button text="Update Selection" onAction="#handleUpdateSelection"/>
         <Button text="Save Selection..." onAction="#handleSaveSelection"/>
      </HBox>

   </VBox>

</AnchorPane>
