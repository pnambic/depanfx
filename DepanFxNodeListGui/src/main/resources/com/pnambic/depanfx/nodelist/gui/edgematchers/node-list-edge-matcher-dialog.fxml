<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="400"
            fx:controller="com.pnambic.depanfx.nodelist.gui.edgematchers.DepanFxNodeListEdgeMatcherDialog" >
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <Label text="Head Node List"/>

         <HBox spacing="10">
            <TextField fx:id="headNodeListField" editable="false"
                  promptText="No node list selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#handleHeadBrowse" />
         </HBox>

         <Label text="Tail Node List"/>

         <HBox spacing="10">
            <TextField fx:id="tailNodeListField" editable="false"
                  promptText="No node list selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#handleTailBrowse" />
         </HBox>

         <Region VBox.vgrow="ALWAYS" />

         <Label text="Edge Matcher Name"/>

         <HBox spacing="10">
            <TextField fx:id="toolNameField" editable="true"
                  promptText="Edge matcher name"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Edge Matcher Description"/>

         <HBox spacing="10">
            <TextField fx:id="toolDescriptionField" editable="true"
                  promptText="Edge matcher description"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Select Destination File"/>

         <HBox spacing="10">
            <TextField fx:id="destinationField" editable="false"
                  promptText="No file selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#openDestinationChooser"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <HBox spacing="10">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Confirm" onAction="#handleConfirm"/>
         </HBox>

   </VBox>
</AnchorPane>
