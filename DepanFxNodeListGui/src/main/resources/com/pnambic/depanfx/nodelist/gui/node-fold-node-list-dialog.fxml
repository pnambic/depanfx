<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="440" prefHeight="1100"
            fx:controller="com.pnambic.depanfx.nodeview.gui.DepanFxNodeFoldNodeListDialog">
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <Label text="Node folding"/>

         <HBox spacing="10">
            <Label text="Nest Node"/>
            <TextField fx:id="nestNameField" editable="false"
                  promptText="Select from available nodes."
                  HBox.hgrow="ALWAYS"/>
            <TextField fx:id="nestKeyField" editable="false"
                  promptText="Select from available nodes."
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <TableView fx:id="nodeListTable" editable="true"
            VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"/>
            <columns>
                <TableColumn text="Node Name"
                    prefWidth="160" minWidth="50"
                    editable="false" sortable="false"/>
                <TableColumn text="Node Key"
                    prefWidth="160" minWidth="50"
                    editable="false" sortable="false"/>
                <TableColumn text="Edit"
                    prefWidth="40" minWidth="30"
                    editable="true"
                    resizable="false" sortable="false"/>
            </columns>
         </TableView>

         <HBox spacing="10">
            <Label text="Fold Into"/>
            <ComboBox fx:id="foldIntoCombo" editable="false"
                  promptText="Select from available nodes."
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <HBox spacing="10">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Confirm" onAction="#handleConfirm"/>
         </HBox>

   </VBox>

</AnchorPane>
