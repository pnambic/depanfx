<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="440"
            fx:controller="com.pnambic.depanfx.nodelist.gui.DepanFxLinkMatcherSequenceToolDialog">
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <Label text="Link Matchers..." fx:id="linkMatchersLabel"/>

         <TableView fx:id="linkMatcherSequenceTable" editable="true"
            VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Link Matcher Resource"
                    editable="false"
                    prefWidth="250" minWidth="50">
                </TableColumn>
                <TableColumn text="Link Matcher Name"
                    editable="false"
                    prefWidth="80" minWidth="50">
                </TableColumn>
                <TableColumn text = "Edit"
                    prefWidth="50"
                    editable="false" resizable="false" sortable="false">
                </TableColumn>
            </columns>
         </TableView>

         <HBox>
            <Button text="Add Link Matcher..." onAction="#addLinkMatcher" />
         </HBox>

         <Label text="Tool Name"/>

         <HBox spacing="10">
            <TextField fx:id="toolNameField" editable="true"
                  promptText="Display label for data source"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Tool Description"/>

         <HBox spacing="10">
            <TextField fx:id="toolDescriptionField" editable="true"
                  promptText="Description"
                  HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Select Destination File"/>

         <HBox spacing="10">
            <TextField fx:id="destinationField" editable="false" promptText="No file selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#openDestinationChooser" />
         </HBox>

         <HBox spacing="10">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Confirm" onAction="#handleConfirm"/>
         </HBox>

   </VBox>

</AnchorPane>
