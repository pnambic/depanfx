<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="640" prefHeight="400"
            fx:controller="com.pnambic.depanfx.nodelist.gui.DepanFxNodeFoldDialog">
   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <HBox spacing="10">
            <Label text="Node foldings" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="New Node Folding..."
                onMouseClicked="#onNewNodeFolding" />
         </HBox>

         <TableView fx:id="captureFoldTable" editable="true"
            VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Node Fold Name"
                    prefWidth="120" minWidth="50"
                    editable="false" sortable="false">
                </TableColumn>
                <TableColumn text = "Node Fold Resource"
                    prefWidth="400"
                    editable="false" sortable="false">
                </TableColumn>
                <TableColumn text="Edit"
                    prefWidth="50" minWidth="50"
                    editable="true" resizable="false" sortable="false">
                </TableColumn>
            </columns>
         </TableView>

         <HBox>
            <Button text="Add Row" onAction="#addNodeFoldRow" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Save All" onAction="#saveAllFoldings" />
         </HBox>

         <Region VBox.vgrow="ALWAYS" />

         <HBox spacing="10">
            <Button text="Close" onAction="#handleCancel"/>
         </HBox>

   </VBox>

</AnchorPane>
