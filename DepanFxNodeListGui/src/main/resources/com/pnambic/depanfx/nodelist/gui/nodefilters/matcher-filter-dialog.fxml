<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="400"
            fx:controller="com.pnambic.depanfx.nodelist.gui.nodefilters.DepanFxNodeFiltersMatcherDialog">

   <VBox spacing="10" layoutX="10" layoutY="10"
         AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10"
         AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10">

         <Label text="Filter Link Matcher"/>

         <HBox spacing="10">
            <TextField fx:id="filterRsrcField" editable="false"
                  promptText="No link matcher selected"
                  HBox.hgrow="ALWAYS"/>
            <Button text="Browse..." onAction="#handleBrowseLinkMatcher"/>
         </HBox>

         <HBox spacing="10">
            <Label text="Reverse links"/>
            <CheckBox fx:id="useInverseCheckBox"/>
         </HBox>

         <HBox spacing="10">
            <Label text="Use Closure"/>
            <CheckBox fx:id="useClosureCheckBox"/>

            <Label text="Merge Mode"/>
            <ComboBox fx:id="mergeModeComboBox"/>
         </HBox>

         <Label text="Sequence Filter Name"/>

         <HBox spacing="10">
            <TextField fx:id="toolNameField" editable="true"
                       promptText="Sequence filter name"
                       HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label text="Sequence FilterDescription"/>

         <HBox spacing="10">
            <TextField fx:id="toolDescriptionField" editable="true"
                       promptText="Sequence filter description"
                       HBox.hgrow="ALWAYS"/>
         </HBox>

         <Label fx:id="saveDestinationLabel" text="Select Destination File"/>

         <HBox fx:id="saveDestinationBox" spacing="10">
            <TextField fx:id="destinationField" editable="false"
                       promptText="No file selected"
                       HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#openDestinationChooser"/>
         </HBox>

         <Region VBox.vgrow="ALWAYS" />

         <HBox fx:id="updateActionBox" spacing="10">
            <Button text="Revert" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Update" onAction="#handleApply"/>
         </HBox>
         <HBox fx:id="saveActionBox" spacing="10">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Confirm" onAction="#handleConfirm"/>
         </HBox>

   </VBox>

</AnchorPane>
